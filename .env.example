# Gmail SMTP Configuration for Titanslab
# 1. Enable 2-Step Verification on titanslabinc@gmail.com
# 2. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
# 3. Create a 16-character App Password (e.g. "abcd efgh ijkl mnop")
GMAIL_USER=titanslabinc@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Target inbox for inquiry notifications
CONTACT_RECIPIENT_EMAIL=titanslabinc@gmail.com

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
